{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "plugin": [
    ".opencode/plugins/graphify.js"
  ],
  "mcp": {
    "graphify": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--no-sync",
        "graphify-mcp",
        "graphify-out/graph.json"
      ],
      "enabled": true
    },
    "rushlab": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--no-sync",
        "rushlab-mcp"
      ],
      "enabled": true
    }
  }
}
