# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# uv
uv.lock.bak

# Data: raw downloads and processed artifacts stay out of git
data/processed/
data/cache/
sumo/

# Simulation outputs
*.sumocfg
*_output.xml
*.rou.xml
*.net.xml
*.vehroutes.xml
*.tripinfo.xml
*.edgedata.xml
*.fcd.xml
tls_output/
results/

# Graphify: commit the graph + report, keep renders and caches local
graphify-out/*
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md

# Benchmark work dirs and transcripts (results stay committed)
evals/.work/
evals/transcripts/

# Claude Code local settings (machine-specific)
.claude/settings.local.json

# Reports generated from runs (keep templates, not outputs)
reports/*.html
!reports/.gitkeep

# OS
.DS_Store
